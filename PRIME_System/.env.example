# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+asyncpg://prime:prime@localhost:5432/prime
JWT_SECRET=prime-demo-only-secret-change-me-0123456789   # >= 32 chars
FERNET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
DEMO_MODE=true          # seeded TOTP secrets, /demo controls, scenario overrides
DEMO_SPEED=10           # replay speed multiplier (1 = real time)
CORS_ORIGINS=http://localhost:5173
